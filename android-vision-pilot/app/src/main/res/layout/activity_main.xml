<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07111F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMART24"
            android:textColor="#00D79A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:text="VISION DIRECT — RTSP / ONVIF"
            android:textColor="#B7C7D9"
            android:textSize="13sp" />

        <Button
            android:id="@+id/openFullSmart24Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#00A859"
            android:text="VOLTAR À LOJA 3D E AO PAINEL COMPLETO"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#102239"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:text="Conexão real: a câmera envia seu vídeo diretamente ao SMART24 pela rede local. O Yoosee não precisa ficar aberto e o Android não grava a tela."
            android:textColor="#DCE7F3"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="1. CONECTAR AO FIREBASE"
            android:textColor="#00D79A"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="E-mail do usuário Firebase"
            android:inputType="textEmailAddress"
            android:textColor="#FFFFFF"
            android:textColorHint="#7890AA" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Senha do Firebase (não é salva)"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#7890AA" />

        <EditText
            android:id="@+id/storeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Loja"
            android:text="loja-01"
            android:textColor="#FFFFFF"
            android:textColorHint="#7890AA" />

        <EditText
            android:id="@+id/cameraInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Identificação da câmera no SMART24"
            android:text="CAM-01"
            android:textColor="#FFFFFF"
            android:textColorHint="#7890AA" />

        <EditText
            android:id="@+id/bridgeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Conector"
            android:text="pilot-android-01"
            android:textColor="#FFFFFF"
            android:textColorHint="#7890AA" />

        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ENTRAR NO FIREBASE" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="2. CÂMERA DIRETA NA REDE LOCAL"
            android:textColor="#00D79A"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="A câmera e este celular precisam estar no mesmo Wi‑Fi. Os valores abaixo correspondem ao equipamento mostrado no Yoosee e continuam editáveis caso o roteador altere o IP."
            android:textColor="#8EA5BD"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/cameraIpInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="IP local da câmera"
            android:inputType="textUri|textNoSuggestions"
            android:text="192.168.15.5"
            android:textColor="#FFFFFF"
            android:textColorHint="#7890AA" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/cameraPortInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Porta RTSP"
                android:inputType="number"
                android:text="554"
                android:textColor="#FFFFFF"
                android:textColorHint="#7890AA" />

            <EditText
                android:id="@+id/cameraPathInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="Fluxo"
                android:inputType="textUri|textNoSuggestions"
                android:text="onvif1"
                android:textColor="#FFFFFF"
                android:textColorHint="#7890AA" />
        </LinearLayout>

        <EditText
            android:id="@+id/cameraUserInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Usuário NVR/RTSP"
            android:inputType="textNoSuggestions"
            android:text="admin"
            android:textColor="#FFFFFF"
            android:textColorHint="#7890AA" />

        <EditText
            android:id="@+id/cameraPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Senha criada em Conexão NVR (nunca é salva)"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#7890AA" />

        <Button
            android:id="@+id/discoverOnvifButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="LOCALIZAR CÂMERA ONVIF NO WI-FI" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="3. DEMONSTRAÇÃO ASSISTIDA"
            android:textColor="#00D79A"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/demoProductNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Nome do item demonstrado"
            android:text="Produto de demonstração"
            android:textColor="#FFFFFF"
            android:textColorHint="#7890AA" />

        <EditText
            android:id="@+id/demoSkuInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="SKU demonstrativo"
            android:text="DEMO-001"
            android:textColor="#FFFFFF"
            android:textColorHint="#7890AA" />

        <EditText
            android:id="@+id/demoZoneInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Zona/prateleira"
            android:text="PRATELEIRA-DEMO"
            android:textColor="#FFFFFF"
            android:textColorHint="#7890AA" />

        <Button
            android:id="@+id/connectDirectButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#00A859"
            android:enabled="false"
            android:text="CONECTAR DIRETAMENTE À CÂMERA"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#102239"
            android:padding="14dp"
            android:text="Aguardando. Ative Conexão NVR no Yoosee, entre no Firebase e conecte diretamente."
            android:textColor="#DCE7F3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="CONTINGÊNCIA DA VERSÃO ANTERIOR"
            android:textColor="#7890AA"
            android:textStyle="bold" />

        <Button
            android:id="@+id/openLegacyCaptureButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="#34465A"
            android:text="Abrir modo antigo de captura de tela"
            android:textColor="#DCE7F3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:text="Mantido somente para não remover funcionalidades da versão 2.3.0. A conexão direta acima é o modo principal."
            android:textColor="#7890AA"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
