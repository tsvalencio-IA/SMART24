<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07111F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMART24"
            android:textColor="#00D79A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="PROTÓTIPO LIMPO • DEMONSTRAÇÃO ASSISTIDA"
            android:textColor="#B7C7D9"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#102239"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:text="Objetivo: provar câmera → pessoa/objeto → evento → Firebase → painel. Nesta versão o operador confirma PEGOU, DEVOLVEU ou SUSPEITA. O sistema não afirma reconhecer SKU automaticamente."
            android:textColor="#DCE7F3"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="PASSO 0 • CONFIRMAR A CÂMERA"
            android:textColor="#00D79A"
            android:textStyle="bold" />

        <Button
            android:id="@+id/openYooseeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Abrir Yoosee e testar câmera" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="PASSO 1 • FIREBASE"
            android:textColor="#00D79A"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:hint="E-mail do Firebase"
            android:inputType="textEmailAddress"
            android:textColor="#FFFFFF"
            android:textColorHint="#7890AA" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Senha do Firebase (não é salva)"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#7890AA" />

        <EditText
            android:id="@+id/storeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Loja"
            android:text="loja-01"
            android:textColor="#FFFFFF"
            android:textColorHint="#7890AA" />

        <EditText
            android:id="@+id/cameraInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Câmera"
            android:text="CAM-01"
            android:textColor="#FFFFFF"
            android:textColorHint="#7890AA" />

        <EditText
            android:id="@+id/bridgeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Conector"
            android:text="pilot-android-demo-01"
            android:textColor="#FFFFFF"
            android:textColorHint="#7890AA" />

        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="1. Entrar no Firebase" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="PASSO 2 • PAINEL SOBRE O YOOSEE"
            android:textColor="#00D79A"
            android:textStyle="bold" />

        <Button
            android:id="@+id/overlayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="2. Autorizar painel flutuante" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="PASSO 3 • INICIAR"
            android:textColor="#00D79A"
            android:textStyle="bold" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:enabled="false"
            android:text="3. Autorizar vídeo e iniciar teste" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:enabled="false"
            android:text="Parar teste" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#102239"
            android:lineSpacingExtra="3dp"
            android:padding="14dp"
            android:text="Aguardando. Comece confirmando que a câmera abre normalmente no Yoosee."
            android:textColor="#DCE7F3" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Durante o teste: Yoosee fica em tela cheia. O pequeno painel SMART24 fica por cima. Toque PEGOU somente depois que a pessoa estiver com o item; DEVOLVEU quando devolver; SUSPEITA somente para criar uma ocorrência de demonstração para revisão humana."
            android:textColor="#8EA5BD"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
