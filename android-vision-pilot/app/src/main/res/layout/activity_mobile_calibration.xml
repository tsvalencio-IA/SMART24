<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#07111F"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SMART24 — Calibrar produtos"
        android:textColor="#00D79A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <br.com.thiaguinhosolucoes.smart24vision.ZoneView
        android:id="@+id/mobileZoneView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/mobileZoneIdInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Zona: PRATELEIRA-01-CANAL-01"
        android:textColor="#FFFFFF"
        android:textColorHint="#7890AA" />

    <EditText
        android:id="@+id/mobileProductNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Produto: Coca-Cola 350 ml"
        android:textColor="#FFFFFF"
        android:textColorHint="#7890AA" />

    <EditText
        android:id="@+id/mobileSkuInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="SKU: COCA-350"
        android:textColor="#FFFFFF"
        android:textColorHint="#7890AA" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/mobileResetZoneButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Refazer" />

        <Button
            android:id="@+id/mobileSaveZoneButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Salvar SKU" />
    </LinearLayout>

    <Button
        android:id="@+id/mobileClearZonesButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apagar todas as zonas desta câmera" />

    <TextView
        android:id="@+id/mobileCalibrationStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#DCE7F3"
        android:padding="8dp" />
</LinearLayout>
