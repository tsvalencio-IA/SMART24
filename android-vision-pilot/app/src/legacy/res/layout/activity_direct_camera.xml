<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07111F"
    android:orientation="vertical"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SMART24 • CÂMERA DIRETA"
            android:textColor="#00D79A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/directModeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#14324B"
            android:paddingStart="9dp"
            android:paddingTop="5dp"
            android:paddingEnd="9dp"
            android:paddingBottom="5dp"
            android:text="RTSP/TCP"
            android:textColor="#7FD7FF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"
        android:minHeight="240dp">

        <androidx.media3.ui.PlayerView
            android:id="@+id/directPlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:keepScreenOn="true"
            app:resize_mode="fit"
            app:show_buffering="always"
            app:surface_type="texture_view"
            app:use_controller="false" />

        <br.com.thiaguinhosolucoes.smart24vision.VisionOverlayView
            android:id="@+id/visionOverlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="false"
            android:focusable="false" />

        <ProgressBar
            android:id="@+id/directProgress"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#00D79A" />
    </FrameLayout>

    <TextView
        android:id="@+id/directStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="#102239"
        android:maxLines="4"
        android:padding="10dp"
        android:text="Conectando diretamente à câmera…"
        android:textColor="#DCE7F3"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/directPickupButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="#00796B"
            android:enabled="false"
            android:minWidth="0dp"
            android:text="PEGOU"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/directReturnButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#1E88E5"
            android:enabled="false"
            android:minWidth="0dp"
            android:text="DEVOLVEU"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/directConcealButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="#EF6C00"
            android:enabled="false"
            android:minWidth="0dp"
            android:text="ESCONDEU"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/directAlertButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#C62828"
            android:enabled="false"
            android:minWidth="0dp"
            android:text="ALERTA"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/directFinishButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#455A64"
            android:enabled="false"
            android:minWidth="0dp"
            android:text="FINALIZAR"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/directCalibrateButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:enabled="false"
            android:minWidth="0dp"
            android:text="CALIBRAR ZONA"
            android:textSize="10sp" />

        <Button
            android:id="@+id/directRetryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="RECONECTAR"
            android:textSize="10sp" />

        <Button
            android:id="@+id/directStopButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="SAIR"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="14dp"
        android:text="Vídeo recebido da câmera pela LAN • sem Yoosee aberto • sem captura da tela"
        android:textAlignment="center"
        android:textColor="#7890AA"
        android:textSize="10sp" />
</LinearLayout>
